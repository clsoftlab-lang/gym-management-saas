#
# Copy to .env (and keep it OUT of git) or export these in your host's env.
# The API key lives ONLY here on the server — never in the browser or the repo.

ANTHROPIC_API_KEY=

# Optional — cost-efficient defaults shown:
# AI_MODEL=claude-haiku-4-5        # raise to claude-sonnet-5 or claude-opus-5 for harder tasks
# AI_MAX_TOKENS=700                # per-task output cap
# AI_EFFORT=low                    # non-Haiku models only (Haiku 4.5 rejects thinking/effort)
# AI_MONTHLY_TOKEN_CAP=2000000     # monthly budget; when exceeded → HTTP 429 {fallback:true}
# AI_RATE_MAX=20                   # requests per window per IP
# AI_RATE_WINDOW_MS=60000
# PORT=8787
# ALLOW_ORIGIN=https://clsoftlab-lang.github.io
